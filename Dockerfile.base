# Native build tools and platform SDKs only; all C++ libraries come from Conan.
FROM ubuntu:24.04 AS base
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git curl zip unzip tar pkg-config ca-certificates \
    python3 python3-venv perl autoconf automake libtool bison flex \
    libgl1-mesa-dev libx11-dev libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev \
    libxkbcommon-dev libwayland-dev wayland-protocols xorg-dev xvfb xauth fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
COPY conan/requirements.txt /tmp/conan-requirements.txt
RUN python3 -m venv /opt/conan && /opt/conan/bin/python -m pip install --no-cache-dir -r /tmp/conan-requirements.txt
ENV PATH="/opt/conan/bin:${PATH}"
COPY conan/linux-system-packages.txt /tmp/linux-system-packages.txt
RUN sed -i 's/\r$//' /tmp/linux-system-packages.txt && apt-get update && xargs -a /tmp/linux-system-packages.txt apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
LABEL org.dynaxis.dependencies="conan-2.29.1"
WORKDIR /app
